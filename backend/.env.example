PORT=3000

# ── Base de datos (Railway MySQL: usa el host/puerto PÚBLICOS) ──
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=railway
# SSL solo si usas Aiven / TiDB / PlanetScale (Railway = déjalo en false)
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...   (pega el PEM en una línea con \n)

# ── Auth ──
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ── CORS: URL(s) del frontend, separadas por coma ──
CORS_ORIGINS=https://tu-frontend.vercel.app

# ── Servicio de IA (FastAPI) ──
IA_URL=https://gams-ia.onrender.com

# ── Web Push (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@gams.gob.bo
